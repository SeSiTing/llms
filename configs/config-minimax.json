{
  "reasoningRequiredModels": ["google/gemini-3.1-pro-preview", "stepfun/step-3.5-flash", "stepfun/step-3.5-flash:free"],
  "LOG": true,
  "LOG_LEVEL": "debug",
  "HOST": "0.0.0.0",
  "PORT": 3000,
  "API_TIMEOUT_MS": "600000",
  "PROXY_URL": "http://127.0.0.1:7890",
  "providers": [
    {
      "id": "ali",
      "name": "ali",
      "type": "anthropic",
      "api_base_url": "${ALI_BASE_URL:-https://coding.dashscope.aliyuncs.com/apps/anthropic}/v1/messages",
      "api_key": "${ALI_API_KEY}",
      "models": [
        "qwen3.5-plus",
        "kimi-k2.5",
        "glm-5",
        "MiniMax-M2.5"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "moonshot",
      "name": "moonshot",
      "type": "anthropic",
      "api_base_url": "${MOONSHOT_BASE_URL:-https://api.kimi.com/coding}/v1/messages",
      "api_key": "${MOONSHOT_API_KEY}",
      "models": [
        "kimi-k2.5",
        "kimi-k2",
        "kimi-k2-thinking"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "openrouter",
      "name": "openrouter",
      "type": "openai",
      "api_base_url": "${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1/chat/completions}",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": [
        "x-ai/grok-4.1-fast",
        "anthropic/claude-opus-4.6",
        "anthropic/claude-sonnet-4.6",
        "anthropic/claude-haiku-4.5",
        "google/gemini-3-flash-preview",
        "google/gemini-3.1-pro-preview",
        "google/gemini-3-pro-preview",
        "google/gemini-2.5-flash",
        "google/gemini-2.5-flash-lite",
        "minimax/minimax-m2.5",
        "moonshotai/kimi-k2.5",
        "z-ai/glm-5",
        "deepseek/deepseek-v3.2",
        "openai/gpt-5.2",
        "openai/gpt-4.1-mini",
        "openai/gpt-5-image",
        "qwen/qwen3-vl-235b-a22b-instruct"
      ],
      "transformer": {
        "use": ["openrouter"]
      }
    },
    {
      "id": "zhipu-glm",
      "name": "zhipu-glm",
      "type": "anthropic",
      "api_base_url": "${ZHIPU_BASE_URL:-https://open.bigmodel.cn/api/anthropic}/v1/messages",
      "api_key": "${ZHIPU_API_KEY}",
      "models": [
        "glm-5"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "minimax",
      "name": "minimax",
      "type": "anthropic",
      "api_base_url": "${MINIMAX_BASE_URL:-https://api.minimaxi.com/anthropic}/v1/messages",
      "api_key": "${MINIMAX_API_KEY}",
      "models": [
        "MiniMax-M2.5",
        "MiniMax-M2.5-highspeed"
      ],
      "transformer": {
        "use": ["passthrough"]
      },
      "timeout": 3000000
    }
  ],
  "Router": {
    "default": "minimax,MiniMax-M2.5",
    "image": "moonshot,kimi-k2.5",
    "rules": [
      {
        "pattern": "claude-haiku|haiku",
        "targetModel": "MiniMax-M2.5",
        "provider": "minimax",
        "description": "Haiku 映射到 MiniMax M2.5"
      },
      {
        "pattern": "claude-sonnet|sonnet",
        "targetModel": "MiniMax-M2.5",
        "provider": "minimax",
        "description": "Sonnet 映射到 MiniMax M2.5"
      },
      {
        "pattern": "claude-opus|opus",
        "targetModel": "MiniMax-M2.5",
        "provider": "minimax",
        "description": "Opus 映射到 MiniMax M2.5"
      }
    ]
  }
}
