{
  "LOG": true,
  "LOG_LEVEL": "debug",
  "HOST": "0.0.0.0",
  "PORT": 3000,
  "API_TIMEOUT_MS": "600000",
  "PROXY_URL": "http://127.0.0.1:7890",
  "providers": [
    {
      "id": "ali",
      "name": "ali",
      "type": "anthropic",
      "api_base_url": "${ALI_BASE_URL:-https://coding.dashscope.aliyuncs.com/apps/anthropic}",
      "api_key": "${ALI_API_KEY}",
      "models": [
        "qwen3.5-plus",
        "kimi-k2.5",
        "glm-5",
        "MiniMax-M2.5"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "moonshot",
      "name": "moonshot",
      "type": "anthropic",
      "api_base_url": "${MOONSHOT_BASE_URL:-https://api.kimi.com/coding}/v1/messages",
      "api_key": "${MOONSHOT_API_KEY}",
      "models": [
        "kimi-k2.5",
        "kimi-k2",
        "kimi-k2-thinking"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "openrouter",
      "name": "openrouter",
      "type": "openai",
      "api_base_url": "${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1/chat/completions}",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": [
        "moonshotai/kimi-k2.5",
        "google/gemini-2.5-flash",
        "google/gemini-2.5-flash-lite",
        "google/gemini-3-flash-preview",
        "openai/gpt-4.1-mini",
        "openai/gpt-5-image",
        "qwen/qwen3-vl-235b-a22b-instruct"
      ],
      "transformer": {
        "use": ["openrouter"]
      }
    },
    {
      "id": "zhipu-glm",
      "name": "zhipu-glm",
      "type": "anthropic",
      "api_base_url": "${ZHIPU_BASE_URL:-https://open.bigmodel.cn/api/anthropic}/v1/messages",
      "api_key": "${ZHIPU_API_KEY}",
      "models": [
        "glm-5"
      ],
      "transformer": {
        "use": ["passthrough"]
      }
    },
    {
      "id": "minimax",
      "name": "minimax",
      "type": "anthropic",
      "api_base_url": "${MINIMAX_BASE_URL:-https://api.minimaxi.com/anthropic}/v1/messages",
      "api_key": "${MINIMAX_API_KEY}",
      "models": [
        "MiniMax-M2.5",
        "MiniMax-M2.5-highspeed"
      ],
      "transformer": {
        "use": ["passthrough"]
      },
      "timeout": 3000000
    }
  ],
  "Router": {
    "default": "ali,qwen3.5-plus",
    "image": "ali,qwen3.5-plus",
    "rules": [
      {
        "pattern": "qwen3\\.5|qwen-3\\.5",
        "targetModel": "qwen3.5-plus",
        "provider": "ali",
        "description": "Qwen3.5 模型路由到阿里云"
      },
      {
        "pattern": "kimi|k2\\.5|k2",
        "targetModel": "kimi-k2.5",
        "provider": "ali",
        "description": "Kimi K2.5 模型路由到阿里云"
      },
      {
        "pattern": "glm|glm-5",
        "targetModel": "glm-5",
        "provider": "ali",
        "description": "GLM 模型路由到阿里云"
      },
      {
        "pattern": "minimax|MiniMax",
        "targetModel": "MiniMax-M2.5",
        "provider": "ali",
        "description": "MiniMax 模型路由到阿里云"
      },
      {
        "pattern": "claude-haiku|haiku",
        "targetModel": "kimi-k2.5",
        "provider": "ali",
        "description": "Claude Haiku 映射到 Kimi K2.5"
      },
      {
        "pattern": "claude-sonnet|sonnet",
        "targetModel": "kimi-k2.5",
        "provider": "ali",
        "description": "Claude Sonnet 映射到 Kimi K2.5"
      },
      {
        "pattern": "claude-opus|opus",
        "targetModel": "kimi-k2.5",
        "provider": "ali",
        "description": "Claude Opus 映射到 Kimi K2.5"
      }
    ]
  }
}
